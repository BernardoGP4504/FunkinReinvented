import funkin.play.PlayState;
import flixel.FlxG;
import flixel.util.FlxTimer;
import funkin.util.Constants;
import funkin.play.PauseSubState;
import funkin.play.GameOverSubState;
import funkin.util.HapticUtil;
import funkin.input.Controls;
import funkin.Preferences;
import funkin.play.character.MultiSparrowCharacter;
import funkin.modding.base.ScriptedFlxAtlasSprite;
import flixel.effects.FlxFlicker;
import funkin.util.TouchUtil;
import funkin.Conductor;

class BFALTREINVENTED extends MultiSparrowCharacter {
	function new() {
		super('bf-alt');
		this.ignoreExclusionPref = ["danceLeft-alt","danceRight-alt","preDance","preDance-secret", "hey", "intro"];
	}
	
	override function onAnimationFinished(name:String) {
		switch (name) {
			case "preDance":
				shouldAlternate = true;
				idleSuffix = '-alt';
			case "hey":
				danceEvery = 2;
				shouldAlternate = null;
				idleSuffix = '';
		}
		super.onAnimationFinished(name);
	}

	public override function onPause(event:PauseScriptEvent) {
		super.onPause(event);
	}

	  function onAnimationFrame(name:String, frameNumber:Int, frameIndex:Int)
    {
    super.onAnimationFrame(name, frameNumber, frameIndex);
    if (!HapticUtil.hapticsAvailable) return;

    // BF's mic drops.
    if (name == 'firstDeath' && frameNumber == 27)
    {
      HapticUtil.vibrate(0, 0.1, 0.1, 1);
    }

    // BF's balls pulsating.
    if (name == 'deathLoop' && (frameNumber == 0 || frameNumber == 18))
    {
      HapticUtil.vibrate(0, 0.1, 0.1, 1);
    }
  }

    function onCreate(event:ScriptEvent)
  {
    super.onCreate(event);

    GameOverSubState.musicSuffix = '-reinvented';

    PauseSubState.musicSuffix = '-reinvented';
  }

	public override function onResume(event:ScriptEvent) {
		super.onResume(event);
	}

	override function getDeathQuote():Null<String> {
		if (PlayState.instance.currentStage.getDad().characterId == "qt-r") 
			return Paths.sound('qtgameover/bf/qtGameover-' + FlxG.random.int(1, 7));
	}

	public override function onUpdate(event)
	{
		super.onUpdate(event);
		if (GameOverSubState.instance == null) return;

		if (GameOverSubState.instance.controls.BACK) {
			GameOverSubState.blueballed = true;
			GameOverSubState.instance.goBack();
		}
	}
}