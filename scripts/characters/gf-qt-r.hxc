import funkin.play.PlayState;
import funkin.play.character.SparrowCharacter;
import funkin.graphics.FunkinSprite;

class GFRCharacterQtAnims extends SparrowCharacter {
	function new() {
		super('gf-qt-r');
	}
	public var boomBoxSpeakers:FunkinSprite;
	function onCreate(event:ScriptEvent) {
		super.onCreate(event);	

		boomBoxSpeakers = FunkinSprite.createSparrow(this.x, this.y, "characters/GF-REINVENTED/speaker_assets");
		boomBoxSpeakers.animation.addByPrefix('boom', 'bumpBox', 24, false);
		boomBoxSpeakers.antialiasing = this.antialiasing;
		
	}
	var indexChange:Bool = false;
	function onUpdate(event:UpdateScriptEvent) {
		super.onUpdate(event);

		boomBoxSpeakers.visible = this.visible;
		if (!indexChange)
		{
            boomBoxSpeakers.x = this.x - 350 + 173;
			boomBoxSpeakers.y = this.y - 118 + 220;
			boomBoxSpeakers.zIndex = this.zIndex - 1;
			boomBoxSpeakers.shader = this.shader;
			PlayState.instance.currentStage.add(boomBoxSpeakers);


			PlayState.instance.currentStage.refresh();
			indexChange = true;
		}
	}
			
override function dance(forceRestart:Bool) {
		super.dance(forceRestart);

		if (boomBoxSpeakers != null && boomBoxSpeakers.animation != null)
			boomBoxSpeakers.animation.play("boom", true);
		
	}

override function resetCharacter(resetCamera:Bool):Void{
		super.resetCharacter(resetCamera);
		shouldAlternate = null;
		idleSuffix = '';

	}
	override function onAnimationFinished(name:String) {
		if (PlayState.instance != null) 
			switch (name) {
				case "preDance":
					idleSuffix = '-alt';
				case "cheer":
					idleSuffix = '';

			}
		super.onAnimationFinished(name);

	}
	
}